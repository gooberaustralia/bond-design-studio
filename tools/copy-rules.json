{
  "$schema": "https://goober.app/schemas/copy-rules.v1.json",
  "bannedPhrases": [
    { "phrase": "in today's fast-paced world", "suggestion": "Cut the throat-clearing opener. Open with the specific claim." },
    { "phrase": "look no further", "suggestion": "Say what the reader gets, not that the search is over." },
    { "phrase": "elevate", "suggestion": "Name the specific improvement instead." },
    { "phrase": "unlock", "suggestion": "Say what becomes possible, plainly." },
    { "phrase": "seamless", "suggestion": "Describe what actually happens, specifically." },
    { "phrase": "game-changer", "suggestion": "Say what changes and for whom." },
    { "phrase": "game changer", "suggestion": "Say what changes and for whom." },
    { "phrase": "delve", "suggestion": "Use a plain verb: look at, cover, explain." },
    { "phrase": "landscape", "suggestion": "Only keep this if literal. A metaphorical landscape (\"the industry landscape\") reads as filler; name the actual thing." }
  ],
  "dash": {
    "message": "No dashes as punctuation. Restructure with a comma, colon, full stop, or parentheses."
  },
  "shapes": [
    {
      "id": "whether-opener",
      "message": "Two-option \"whether\" opener reads as filler. State the one thing that matters.",
      "pattern": "\\bwhether\\s+you'?re\\b[^.?!]*?\\bor\\b"
    },
    {
      "id": "not-x-its-y",
      "message": "\"Not X, it's Y\" contrast is an AI tell. State the claim plainly.",
      "pattern": "\\b(?:it'?s|that'?s|this\\s+is)\\s+not\\s+(?:just\\s+)?[a-z0-9 '’]+?,\\s*(?:it'?s|that'?s)\\b"
    },
    {
      "id": "rhetorical-opener",
      "message": "Rhetorical question used as a filler opener. Open with the answer instead.",
      "pattern": "(?:^|[.!?]\\s+)(?:Ever\\s+wonder|Looking\\s+for|Need\\s+(?:a|some)|Want\\s+(?:a|to)|Tired\\s+of|Struggling\\s+with)\\b[^.?!]*\\?"
    }
  ],
  "australianSpelling": [
    { "us": "organize", "au": "organise" }, { "us": "organizes", "au": "organises" },
    { "us": "organized", "au": "organised" }, { "us": "organizing", "au": "organising" },
    { "us": "organization", "au": "organisation" }, { "us": "organizations", "au": "organisations" },
    { "us": "color", "au": "colour" }, { "us": "colors", "au": "colours" },
